{
  "expo": {
    "name": "Signiq Scanner",
    "slug": "signiq-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f6f2ea",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "La caméra sert à scanner les badges QR des membres pour enregistrer leur présence."
      }
    },
    "android": {
      "package": "cd.signiq.scanner",
      "versionCode": 1,
      "permissions": ["CAMERA", "VIBRATE"],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à scanner les badges QR des membres pour enregistrer leur présence."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
