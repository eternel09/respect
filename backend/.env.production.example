# ── Backend Laravel — variables d'environnement Dokploy (PROD) ───────────────
# À coller dans l'onglet Environment de l'application "backend".
# ⚠️ Les valeurs secrètes (APP_KEY, DB_PASSWORD, WHATSAPP_SERVICE_KEY) sont à
#    saisir par toi — ne les commite jamais.

APP_NAME=Signiq
APP_ENV=production
APP_DEBUG=false
# Génère la clé en local :  php artisan key:generate --show
APP_KEY=
APP_URL=https://api.tondomaine.cd

LOG_CHANNEL=stderr
LOG_LEVEL=error

# ── Base de données (PostgreSQL déjà provisionnée dans Dokploy) ──────────────
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Sessions / cache / file (pas de worker → sync) ──────────────────────────
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ── CORS : origine(s) du back-office web (séparées par des virgules) ────────
CORS_ALLOWED_ORIGINS=https://app.tondomaine.cd

# ── Service WhatsApp (URL interne Dokploy + clé partagée) ───────────────────
# WHATSAPP_SERVICE_KEY doit être IDENTIQUE à API_KEY du service whatsapp.
WHATSAPP_SERVICE_URL=http://whatsapp:3001
WHATSAPP_SERVICE_KEY=

# ── Email (optionnel : liens/mots de passe des admins d'org) ────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@tondomaine.cd
MAIL_FROM_NAME=Signiq
