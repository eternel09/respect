# Origine de l'API backend. En prod (sous-domaines) : https://api.mondomaine.
# Laisser vide en dev → chemin relatif "/api" servi par le proxy Vite.
VITE_API_URL=

# Lien de téléchargement de l'app mobile scanner (APK Android). Laisser vide
# pour utiliser la Release GitHub par défaut (tag `mobile-latest`).
VITE_APP_DOWNLOAD_URL=
