# ── Service WhatsApp — variables d'environnement Dokploy (PROD) ──────────────
# À coller dans l'onglet Environment de l'application "whatsapp".

PORT=3001

# Clé partagée avec le backend. DOIT être identique à WHATSAPP_SERVICE_KEY côté
# backend. Génère une valeur aléatoire forte (ex. openssl rand -hex 24).
API_KEY=

# Chromium système (déjà défini dans le Dockerfile, rappelé ici pour clarté)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_DOWNLOAD=true
